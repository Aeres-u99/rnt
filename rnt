set -euo pipefail
red="\e[0;91m"
blue="\e[0;94m"
expand_bg="\e[K"
blue_bg="\e[0;104m${expand_bg}"
red_bg="\e[0;101m${expand_bg}"
green_bg="\e[0;102m${expand_bg}"
green="\e[0;92m"
white="\e[0;97m"
bold="\e[1m"
uline="\e[4m"
reset="\e[0m"

show_help() {
    cat <<EOF
Usage: $(basename "$0") <file>

Rename a file using metadata (Title + Author).

Supports:
  PDF, EPUB, CBZ, CBR, images, etc.

Basically attempts to use the metadata information, available in the pdfinfo, exiftool or else performs a basic cleanup.
Options:
  -h, --help    Show help
EOF
}

remove_last_word() {
    # Just a safe workaround to remove the last word which is broken in case
    # nothing is found in metadata
    echo "$1" | awk '{ if (NF > 1) { NF--; print } }'
}

deep_inspection_epub() {
    local file="$1"
    local tmpdir
    tmpdir="$(mktemp -d)"

    trap 'rm -rf "$tmpdir"' RETURN

    unzip -qq "$file" -d "$tmpdir" || return

    local opf_path
    opf_path=$(grep -oP 'full-path="\K[^"]+' "$tmpdir/META-INF/container.xml" 2>/dev/null || true)

    if [[ -z "$opf_path" ]]; then
        opf_path=$(find "$tmpdir" -name '*.opf' | head -n 1 || true)
    else
        opf_path="$tmpdir/$opf_path"
    fi

    [[ -z "$opf_path" || ! -f "$opf_path" ]] && return

    local t a
    t=$(grep -oP '<dc:title[^>]*>\K[^<]+' "$opf_path" | head -n 1 || true)
    a=$(grep -oP '<dc:creator[^>]*>\K[^<]+' "$opf_path" | head -n 1 || true)

    [[ -n "$t" ]] && title="$t"
    [[ -n "$a" ]] && author="$a"
}

clean_text() {
    echo "$1" \
    | sed -E 's/\(.*?\)//g; s/\[.*?\]//g' \
    | xargs
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ $# -lt 1 ]]; then
    echo -e "${red}Error${reset}: No file provided"
    exit 1
fi

file="$1"

if [[ ! -f "$file" ]]; then
    echo -e "${red}Error${reset}: File does not exist → $file"
    exit 1
fi

for cmd in exiftool file pdfinfo unzip; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "${red}Error${reset}: '$cmd' is not installed"
        exit 1
    fi
done

mime=$(file --mime-type -b "$file")

title=$(exiftool -s3 -Title "$file" 2>/dev/null || true)
author=$(exiftool -s3 -Author "$file" 2>/dev/null || true)

# EPUB often uses different tags
[[ -z "$title" ]] && title=$(exiftool -s3 -BookName "$file" 2>/dev/null || true)
[[ -z "$author" ]] && author=$(exiftool -s3 -Creator "$file" 2>/dev/null || true)

if [[ "$mime" == "application/pdf" ]]; then
    p_title=$(pdfinfo "$file" 2>/dev/null | awk -F': ' '/^Title/ {print $2}')
    p_author=$(pdfinfo "$file" 2>/dev/null | awk -F': ' '/^Author/ {print $2}')

    [[ -n "$p_title" && "$p_title" != "untitled" ]] && title="$p_title"
    [[ -n "$p_author" ]] && author="$p_author"
fi

if [[ "$mime" == "application/epub+zip" ]]; then
    if [[ -z "$title" || -z "$author" ]]; then
        deep_inspection_epub "$file"
    fi
fi

title=$(clean_text "$title")
author=$(clean_text "$author")

if [[ -z "$title" || -z "$author" ]]; then
    base="$(basename "$file")"
    base="${base%.*}"
    base=$(echo "$base" | sed -E 's/\(.*?\)//g; s/\[.*?\]//g')
    base=$(remove_last_word "$base")
    base=$(echo "$base" | xargs)
    [[ -z "$title" ]] && title="$base"
    [[ -z "$author" ]] && author="Unknown"
fi

ext="${file##*.}"

new_name="${title} - ${author}.${ext}"
new_name=$(echo "$new_name" | tr '/' '-' | tr -d '\n')

dir="$(dirname "$file")"
target="$dir/$new_name"

if [[ -z "$title" ]]; then
    echo "${red}Error${reset}: Title empty after processing"
    exit 1
fi

if [[ -e "$target" ]]; then
    echo "${red}Error${reset}: Target exists → $target"
    exit 1
fi

echo "Renaming:"
echo "  From: $file"
echo "  To:   $target"

mv "$file" "$target"
